# --- Pinecone (obligatorio) ---
PINECONE_API_KEY=
INDEX_NAME=rag-hybrid-retrieval
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=docs

# --- Proveedores ---
# Embeddings: openai | gemini | voyage | cohere | openai_compatible
EMBEDDING_PROVIDER=gemini
# LLM / chat: openai | gemini | anthropic | grok | openai_compatible
LLM_PROVIDER=gemini

# --- API keys (solo las del proveedor activo son obligatorias) ---
GOOGLE_API_KEY=
# GEMINI_API_KEY=   # alias opcional de GOOGLE_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

# --- Modelos (defaults por proveedor si se omiten) ---
# gemini embeddings → models/gemini-embedding-001 (dim 768 recomendada)
# openai embeddings → text-embedding-3-small (dim 1536)
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSION=768
LLM_MODEL=gemini-2.0-flash

# --- Endpoints OpenAI-compatible (obligatorios si usás ese provider) ---
# EMBEDDING_BASE_URL=https://api.ejemplo.com/v1
# LLM_BASE_URL=https://api.x.ai/v1
